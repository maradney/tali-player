*-plan.md
*-notes.md
*-draft.md
*.local.md

.claude/

# Local developer scratch — useful on disk, not worth publishing
compile_project.sh
project_progress.txt

# Playlists and subscription data. These carry a provider's URL and often
# embedded credentials; the app ships with no content sources of any kind and
# none must ever arrive by way of a commit.
*.m3u
*.m3u8
*.xmltv

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/dist/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated localizations (flutter gen-l10n)
/lib/l10n/app_localizations*.dart

# Android release signing. android/.gitignore already covers key.properties and
# keystores under android/; these catch a keystore left anywhere else in the
# repo. The keystore IS the app's identity - lose it and no future version can
# be published as an update, leak it and someone else can sign builds Android
# accepts as yours. See tool/ANDROID_SIGNING.md.
*.jks
*.keystore
